# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
{%- if options %}
{
{%- for option in options %}
	{{ option }}
{%- endfor %}
}
{%- endif %}
{%- if security %}

# Logs of every site; CrowdSec reads the `crowdsec` one.
(compost_log) {
{%- if access_log %}
	log
{%- endif %}
	log crowdsec {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
{%- for line in log_lines %}
	{{ line }}
{%- endfor %}
}

# Imported by every site without `security` of its own.
(compost_site) {
	import compost_log
	import compost_security {args[0]}
}
{{ security }}
{%- else %}

# Imported by every site.
(compost_site) {
{%- if access_log %}
	log
{%- endif %}
}
{%- endif %}
{%- if metrics_port %}

# Metrics for the monitoring app; not published on the host.
http://:{{ metrics_port }} {
	metrics
}
{%- endif %}

# One file per application instance, written by `compost app deploy`.
import /etc/caddy/sites/*.caddy
{%- if custom_sites %}

# Sites from `configuration.sites` in compost-server.yaml.
import /etc/caddy/custom/*.caddy
{%- endif %}
