# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
{%- if crowdsec %}
    # Built on the server from build/Dockerfile; the tag follows its contents.
    build: ./build
{%- endif %}
    image: {{ image }}
    container_name: {{ container }}
    # The deploy user, so files in data/ and config/ belong to it.
    user: "{{ user }}"
    restart: unless-stopped
{%- if crowdsec %}
    env_file: [secrets/crowdsec.env]
{%- endif %}
    ports:
      - "{{ http_port }}:80"
{%- if publish_https %}
      - "{{ https_port }}:443"
      - "{{ https_port }}:443/udp"
{%- endif %}
    volumes:
      # The folder, not single files: compost replaces files, and a file
      # mount would keep showing the old one after a reload.
      - ./conf:/etc/caddy:ro
      - ./data:/data
      - ./config:/config
{%- if crowdsec %}
      - ./logs:/var/log/caddy
{%- endif %}
    networks: [{{ service_networks | join(", ") }}]
{%- if crowdsec %}
  # Reads Caddy's access log, bans addresses and runs AppSec for Caddy. Only
  # on the private network: apps and other shared apps cannot reach it.
  {{ crowdsec.service }}:
    image: {{ crowdsec.image }}
    container_name: {{ container }}-crowdsec
    restart: unless-stopped
    labels:
      # Its files are mounted one by one, which only a new container sees:
      # a change of them changes this file, so the deploy recreates it.
      compost.config-hash: "{{ crowdsec.config_hash }}"
    env_file: [secrets/crowdsec.env]
    environment:
      COLLECTIONS: "{{ crowdsec.collections | join(" ") }}"
      SCENARIOS: "{{ crowdsec.scenarios | join(" ") }}"
    volumes:
      - crowdsec-data:/var/lib/crowdsec/data
      - crowdsec-config:/etc/crowdsec
      - ./conf/crowdsec/acquis-caddy.yaml:/etc/crowdsec/acquis.d/compost-caddy.yaml:ro
      - ./conf/crowdsec/acquis-appsec.yaml:/etc/crowdsec/acquis.d/compost-appsec.yaml:ro
      - ./conf/crowdsec/profiles.yaml:/etc/crowdsec/profiles.yaml:ro
      - ./conf/crowdsec/simulation.yaml:/etc/crowdsec/simulation.yaml:ro
      - ./conf/crowdsec/ignore.yaml:/etc/crowdsec/parsers/s02-enrich/compost-ignore.yaml:ro
{%- if crowdsec.whitelist %}
      - ./conf/crowdsec/whitelist.yaml:/etc/crowdsec/parsers/s02-enrich/compost-whitelist.yaml:ro
{%- endif %}
      - ./logs:/var/log/caddy:ro
    networks: [crowdsec]
{%- endif %}
networks:
{%- for network in networks %}
  {{ network }}:
    external: true
{%- endfor %}
{%- if crowdsec %}
  crowdsec: {}
volumes:
  crowdsec-data: {}
  crowdsec-config: {}
{%- endif %}
