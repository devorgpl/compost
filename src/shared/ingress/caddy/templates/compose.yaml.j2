# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  caddy:
    image: {{ image }}
    # The deploy user, so files in data/ and config/ belong to it.
    user: "{{ user }}"
    restart: unless-stopped
    ports:
      - "{{ http_port }}:80"
{%- if publish_https %}
      - "{{ https_port }}:443"
      - "{{ https_port }}:443/udp"
{%- endif %}
    volumes:
      - ./conf/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./conf/sites:/etc/caddy/sites:ro
      - ./data:/data
      - ./config:/config
    networks: [{{ network }}]
networks:
  {{ network }}:
    external: true
