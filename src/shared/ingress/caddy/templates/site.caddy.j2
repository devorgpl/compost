{{ addresses }} {
	import compost_site
{%- for route in routes %}
	@{{ route.name }} path {{ route.path }} {{ route.path }}/*
	handle @{{ route.name }} {
{%- if route.strip_prefix %}
		uri strip_prefix {{ route.path }}
{%- endif %}
		reverse_proxy {{ route.upstream }}
	}
{%- endfor %}
	handle {
{%- if fallback %}
		reverse_proxy {{ fallback }}
{%- else %}
		respond 404
{%- endif %}
	}
}
