# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/postgres.env]
    environment:
      POSTGRES_USER: postgres
      # Explicit, because the default location changed in postgres 18 images.
      PGDATA: /var/lib/postgresql/data
    volumes:
      - ./data:/var/lib/postgresql/data
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      retries: 12
networks:
  {{ network }}:
    external: true
