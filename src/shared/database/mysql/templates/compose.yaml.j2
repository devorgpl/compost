# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/{{ env_file }}]
    volumes:
      - ./data:/var/lib/mysql
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      test: {{ healthcheck }}
      interval: 5s
      retries: 24
networks:
  {{ network }}:
    external: true
