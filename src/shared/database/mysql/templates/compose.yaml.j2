# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
{%- if host_port %}
    # Also on this machine's loopback address, for processes outside Docker.
    ports: ["127.0.0.1:{{ host_port }}:3306"]
{%- endif %}
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/{{ env_file }}]
    volumes:
      - ./data:/var/lib/mysql
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      test: {{ healthcheck }}
      interval: 5s
      retries: 24
networks:
  {{ network }}:
    external: true
