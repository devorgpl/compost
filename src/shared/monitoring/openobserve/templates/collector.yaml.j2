# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
extensions:
  basicauth/openobserve:
    client_auth:
      username: ${env:OPENOBSERVE_USER}
      password: ${env:OPENOBSERVE_PASSWORD}
receivers:
  otlp:
    protocols:
      grpc: {endpoint: "0.0.0.0:4317"}
      http: {endpoint: "0.0.0.0:4318"}
  # Docker output of linked services (fluentd log driver).
  fluent_forward:
    endpoint: "0.0.0.0:24224"
  # Metrics endpoints of linked services, one file per link.
  prometheus:
    config:
      scrape_configs:
        - job_name: compost
          scrape_interval: 30s
          file_sd_configs:
            - files: [/etc/otelcol/targets/*.yaml]
{%- if container_metrics %}
  docker_stats:
    endpoint: unix:///var/run/docker.sock
    collection_interval: 30s
    container_labels_to_metric_labels:
      com.docker.compose.project: compose_project
      com.docker.compose.service: compose_service
{%- endif %}
processors:
  batch: {}
exporters:
  otlp_http/openobserve:
    endpoint: http://openobserve:5080/api/default
    auth: {authenticator: basicauth/openobserve}
  otlp_http/docker:
    endpoint: http://openobserve:5080/api/default
    auth: {authenticator: basicauth/openobserve}
    headers: {stream-name: docker}
service:
  extensions: [basicauth/openobserve]
  pipelines:
    logs/docker:
      receivers: [fluent_forward]
      processors: [batch]
      exporters: [otlp_http/docker]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp_http/openobserve]
    metrics:
      receivers: [otlp, prometheus{% if container_metrics %}, docker_stats{% endif %}]
      processors: [batch]
      exporters: [otlp_http/openobserve]
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp_http/openobserve]
