# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  openobserve:
    image: {{ image }}
    # The deploy user, so files in data/ belong to it.
    user: "{{ user }}"
    restart: unless-stopped
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/openobserve.env]
    environment:
      ZO_DATA_DIR: /data
      ZO_TELEMETRY: "false"
{%- if retention_days %}
      ZO_COMPACT_DATA_RETENTION_DAYS: "{{ retention_days }}"
{%- endif %}
    volumes:
      - ./data:/data
  # Receives what apps send and forwards it to OpenObserve. Apps reach it on
  # the monitoring network; only the collector knows OpenObserve's password.
  collector:
    image: {{ collector_image }}
    restart: unless-stopped
    command: ["--config=/etc/otelcol/config.yaml"]
    env_file: [./secrets/collector.env]
{%- if socket_group %}
    # Container CPU and memory metrics are read from the docker socket.
    group_add: ["{{ socket_group }}"]
{%- endif %}
    volumes:
      - ./collector/config.yaml:/etc/otelcol/config.yaml:ro
      - ./collector/targets:/etc/otelcol/targets:ro
{%- if socket_group %}
      - /var/run/docker.sock:/var/run/docker.sock:ro
{%- endif %}
    ports:
      # The docker log driver of linked services delivers their output here.
      - "127.0.0.1:{{ forward_port }}:24224"
    networks:
      default: {}
      {{ network }}:
        aliases: [{{ host }}]
    depends_on: [openobserve]
networks:
  {{ network }}:
    external: true
