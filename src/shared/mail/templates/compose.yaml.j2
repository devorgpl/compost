# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  # The inbox, and SMTP for apps. Mail stays in memory until it restarts.
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    # MP_UI_AUTH: the inbox's login.
    env_file: [./secrets/mailpit.env]
    environment:
      # Apps may log in to SMTP with any user and password, without TLS.
      MP_SMTP_AUTH_ACCEPT_ANY: "true"
      MP_SMTP_AUTH_ALLOW_INSECURE: "true"
{%- if host_port %}
    ports: ["127.0.0.1:{{ host_port + 1 }}:{{ smtp_port }}"]
{%- endif %}
    networks:
      default: {}
      {{ network }}:
        aliases: [{{ host }}]
  # The AWS SES API (v1 and v2); it hands every mail to Mailpit.
  {{ service }}-ses:
    image: {{ ses_image }}
    container_name: {{ container }}-ses
    restart: unless-stopped
    environment:
      SMTP_TRANSPORT: '{{ smtp_transport }}'
{%- if host_port %}
    ports: ["127.0.0.1:{{ host_port }}:{{ ses_port }}"]
{%- endif %}
    networks:
      default: {}
      {{ network }}:
        aliases: [{{ host }}-ses]
    depends_on: [{{ service }}]
{%- if moto_image %}
  # Other AWS APIs (Cognito, SNS, …), in memory.
  {{ service }}-aws:
    image: {{ moto_image }}
    container_name: {{ container }}-aws
    restart: unless-stopped
{%- if host_port %}
    ports: ["127.0.0.1:{{ host_port + 2 }}:{{ moto_port }}"]
{%- endif %}
    networks:
      default: {}
      {{ network }}:
        aliases: [{{ host }}-aws]
{%- endif %}
networks:
  {{ network }}:
    external: true
