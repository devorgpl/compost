# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    labels:
      # Changes with server.conf and the password, which need a restart; a
      # change of users alone is loaded without one.
      compost.config: "{{ config_hash }}"
    command: ["{{ server }}", "/conf/server.conf"]
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/password.env]
    volumes:
      - ./data:/data
      - ./conf:/conf:ro
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"$$KV_PASSWORD\" {{ cli }} ping | grep -q PONG"]
      interval: 5s
      retries: 12
networks:
  {{ network }}:
    external: true
