# Generated by compost; runs inside the admin container (sh -s), which sets TEMPORAL_ADDRESS.
set -eu
namespace='{{ namespace }}'
# The rest of this script is read from stdin: commands without input read /dev/null.
i=0
until temporal operator cluster health </dev/null >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -ge 60 ]; then echo "Temporal does not answer at $TEMPORAL_ADDRESS" >&2; exit 1; fi
  sleep 1
done
{%- if purge %}
if temporal operator namespace describe -n "$namespace" </dev/null >/dev/null 2>&1; then
  temporal operator namespace delete -n "$namespace" --yes </dev/null >/dev/null
fi
{%- else %}
if temporal operator namespace describe -n "$namespace" </dev/null >/dev/null 2>&1; then
  temporal operator namespace update -n "$namespace" --retention '{{ retention }}' </dev/null >/dev/null
else
  temporal operator namespace create -n "$namespace" --retention '{{ retention }}' \
    --description '{{ description }}' </dev/null >/dev/null
fi
{%- endif %}
