# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
# compose.override.yaml adds the database{% if ui %}, ingress{% if oidc %} and oidc{% endif %}{% endif %} networks and settings.
services:
  # Creates or updates the tables in both databases, then exits.
  {{ schema_service }}:
    image: {{ admin_tools_image }}
    container_name: {{ container }}-schema
    restart: "no"
    labels:
      # Changes with the script, so a new one runs.
      compost.script: "{{ script_hash }}"
    entrypoint: ["/bin/sh", "/scripts/schema.sh"]
    volumes:
      - ./schema.sh:/scripts/schema.sh:ro
    networks:
      default: {}
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    env_file: [./cluster.env]
    environment:
      DB: postgres12
      BIND_ON_IP: 0.0.0.0
      DYNAMIC_CONFIG_FILE_PATH: /etc/temporal/config/dynamicconfig/docker.yaml
      # Not published; scraped by a monitoring link.
      PROMETHEUS_ENDPOINT: 0.0.0.0:{{ metrics_port }}
    volumes:
      - ./dynamicconfig:/etc/temporal/config/dynamicconfig:ro
    networks:
      default: {}
      {{ network }}:
        aliases: [{{ host }}]
    depends_on:
      {{ schema_service }}:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "{{ port }}"]
      interval: 5s
      retries: 30
      start_period: 30s
  # Runs the `temporal` CLI for compost: namespaces of links.
  {{ admin_service }}:
    image: {{ admin_tools_image }}
    container_name: {{ container }}-admin
    restart: unless-stopped
    environment:
      TEMPORAL_ADDRESS: {{ service }}:{{ port }}
    networks:
      default: {}
{%- if ui %}
  {{ ui_service }}:
    image: {{ ui.image }}
    container_name: {{ container }}-ui
    restart: unless-stopped
    environment:
      TEMPORAL_ADDRESS: {{ service }}:{{ port }}
      TEMPORAL_CORS_ORIGINS: "{{ ui.url }}"
{%- if ui.insecure_cookie %}
      # Plain HTTP: the CSRF cookie cannot be secure.
      TEMPORAL_CSRF_COOKIE_INSECURE: "true"
{%- endif %}
{%- if oidc %}
      TEMPORAL_AUTH_ENABLED: "true"
      TEMPORAL_AUTH_TYPE: oidc
      TEMPORAL_AUTH_CALLBACK_URL: "{{ ui.url }}/auth/sso/callback"
      TEMPORAL_AUTH_SCOPES: openid,profile,email
{%- endif %}
    networks:
      default: {}
    depends_on: [{{ service }}]
{%- endif %}
networks:
  {{ network }}:
    external: true
