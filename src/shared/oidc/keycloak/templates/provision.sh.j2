# Generated by compost; runs inside the Keycloak container (bash -s).
# JSON bodies follow in quoted here-documents, so nothing in them is expanded.
set -eu
config=/tmp/compost-kcadm-$$.config
trap 'rm -f "$config"' EXIT
kc() { /opt/keycloak/bin/kcadm.sh "$@" --config "$config"; }
# The rest of this script is read from stdin: commands without input read /dev/null.
kc config credentials --server http://localhost:8080 --realm master \
  --user "$KC_BOOTSTRAP_ADMIN_USERNAME" --password "$KC_BOOTSTRAP_ADMIN_PASSWORD" </dev/null >/dev/null
realm='{{ realm }}'
{%- if purge %}
id=$(kc get clients -r "$realm" -q clientId='{{ client_id }}' --fields id --format csv --noquotes </dev/null || true)
if [ -n "$id" ]; then kc delete "clients/$id" -r "$realm" </dev/null; fi
{%- for user in users %}
id=$(kc get users -r "$realm" -q username='{{ user.username }}' -q exact=true --fields id --format csv --noquotes </dev/null || true)
if [ -n "$id" ]; then kc delete "users/$id" -r "$realm" </dev/null; fi
{%- endfor %}
{%- if delete_realm %}
if kc get "realms/$realm" </dev/null >/dev/null 2>&1; then kc delete "realms/$realm" </dev/null; fi
{%- endif %}
{%- else %}
if ! kc get "realms/$realm" </dev/null >/dev/null 2>&1; then
  kc create realms -s realm="$realm" -s enabled=true </dev/null
fi
kc update "realms/$realm" -s 'attributes.frontendUrl={{ frontend_url }}' </dev/null
{%- if realm_json %}
kc update "realms/$realm" -f - <<'COMPOST_JSON'
{{ realm_json }}
COMPOST_JSON
{%- endif %}
{%- for scope in client_scopes %}
{%- if loop.first %}
# The ID of client scope $1, empty when it is missing.
scope_id() {
  kc get client-scopes -r "$realm" --fields id,name --format csv --noquotes </dev/null |
    while IFS=, read -r found name; do if [ "$name" = "$1" ]; then echo "$found"; fi; done
}
{%- endif %}
# Client scope {{ scope.name }}: its settings and exactly the mappers listed.
sid=$(scope_id '{{ scope.name }}')
if [ -z "$sid" ]; then
  kc create client-scopes -r "$realm" -f - <<'COMPOST_JSON'
{{ scope.json }}
COMPOST_JSON
  sid=$(scope_id '{{ scope.name }}')
else
  kc update "client-scopes/$sid" -r "$realm" -f - <<'COMPOST_JSON'
{{ scope.json }}
COMPOST_JSON
fi
mappers=$(kc get "client-scopes/$sid/protocol-mappers/models" -r "$realm" --fields id,name --format csv --noquotes </dev/null)
while IFS=, read -r mid name; do
  if [ -z "$mid" ]; then continue; fi
  case ' {{ scope.mapper_names | join(" ") }} ' in
    *" $name "*) ;;
    *) kc delete "client-scopes/$sid/protocol-mappers/models/$mid" -r "$realm" </dev/null ;;
  esac
done <<< "$mappers"
{%- for mapper in scope.mappers %}
mid=''
while IFS=, read -r found name; do
  if [ "$name" = '{{ mapper.name }}' ]; then mid=$found; fi
done <<< "$mappers"
if [ -z "$mid" ]; then
  kc create "client-scopes/$sid/protocol-mappers/models" -r "$realm" -f - <<'COMPOST_JSON'
{{ mapper.json }}
COMPOST_JSON
else
  kc update "client-scopes/$sid/protocol-mappers/models/$mid" -r "$realm" --merge -f - <<'COMPOST_JSON'
{{ mapper.json }}
COMPOST_JSON
fi
{%- endfor %}
{%- endfor %}
{%- if roles %}
# Each kcadm call starts a JVM: read what exists once.
existing=$'\n'$(kc get roles -r "$realm" --fields name --format csv --noquotes </dev/null)$'\n'
{%- for role in roles %}
case "$existing" in *$'\n{{ role }}\n'*) ;; *) kc create roles -r "$realm" -s name='{{ role }}' </dev/null ;; esac
{%- endfor %}
{%- endif %}
id=$(kc get clients -r "$realm" -q clientId='{{ client_id }}' --fields id --format csv --noquotes </dev/null)
if [ -z "$id" ]; then
  kc create clients -r "$realm" -f - <<'COMPOST_JSON'
{{ client_json }}
COMPOST_JSON
  id=$(kc get clients -r "$realm" -q clientId='{{ client_id }}' --fields id --format csv --noquotes </dev/null)
else
  kc update "clients/$id" -r "$realm" -f - <<'COMPOST_JSON'
{{ client_json }}
COMPOST_JSON
fi
{%- if default_scopes is not none %}
{%- if remove_other_scopes %}
# Client updates ignore the scopes: remove the others, then add the missing ones.
{%- else %}
# Client updates ignore the scopes: add the missing ones.
{%- endif %}
wanted=' {{ default_scopes | join(" ") }} '
current=$(kc get "clients/$id/default-client-scopes" -r "$realm" --fields id,name --format csv --noquotes </dev/null)
have=' '
while IFS=, read -r scope name; do
  if [ -z "$scope" ]; then continue; fi
  case "$wanted" in
    *" $name "*) have="$have$name " ;;
{%- if remove_other_scopes %}
    *) kc delete "clients/$id/default-client-scopes/$scope" -r "$realm" </dev/null ;;
{%- endif %}
  esac
done <<< "$current"
scopes=''
for wanted_name in $wanted; do
  case "$have" in *" $wanted_name "*) continue ;; esac
  if [ -z "$scopes" ]; then
    scopes=$(kc get client-scopes -r "$realm" --fields id,name --format csv --noquotes </dev/null)
  fi
  scope=''
  while IFS=, read -r found name; do
    if [ "$name" = "$wanted_name" ]; then scope=$found; fi
  done <<< "$scopes"
  if [ -z "$scope" ]; then echo "client scope \`$wanted_name\` does not exist in realm $realm" >&2; exit 1; fi
  kc update "clients/$id/default-client-scopes/$scope" -r "$realm" -b '{}' </dev/null
done
{%- endif %}
{%- if user_attributes %}
# Attributes outside the user profile: admins may set them, users only see them.
profile=$(kc get users/profile -r "$realm" </dev/null)
case "$profile" in
  *'"unmanagedAttributePolicy" : "ENABLED"'* | *'"unmanagedAttributePolicy" : "ADMIN_EDIT"'*) ;;
  *'"unmanagedAttributePolicy"'*)
    printf '%s' "$profile" | sed 's/"unmanagedAttributePolicy" : "[A-Z_]*"/"unmanagedAttributePolicy" : "ADMIN_EDIT"/' |
      kc update users/profile -r "$realm" -f - ;;
  *)
    printf '%s' "$profile" | sed '1s/^{/{ "unmanagedAttributePolicy" : "ADMIN_EDIT",/' |
      kc update users/profile -r "$realm" -f - ;;
esac
{%- endif %}
{%- for user in users %}
id=$(kc get users -r "$realm" -q username='{{ user.username }}' -q exact=true --fields id --format csv --noquotes </dev/null)
if [ -z "$id" ]; then
{%- if user.import_json %}
  if ! kc create partialImport -r "$realm" -f - >/dev/null <<'COMPOST_JSON'
{{ user.import_json }}
COMPOST_JSON
  then
    echo "cannot create user {{ user.username }} with id {{ user.id }}: user IDs are unique in the whole Keycloak, is it used in another realm?" >&2
    exit 1
  fi
{%- else %}
  kc create users -r "$realm" -f - <<'COMPOST_JSON'
{{ user.json }}
COMPOST_JSON
{%- endif %}
  id=$(kc get users -r "$realm" -q username='{{ user.username }}' -q exact=true --fields id --format csv --noquotes </dev/null)
{%- if user.temporary %}
  kc update "users/$id/reset-password" -r "$realm" -f - <<'COMPOST_JSON'
{{ user.password_json }}
COMPOST_JSON
{%- endif %}
{%- if user.id %}
elif [ "$id" != '{{ user.id }}' ]; then
  echo "warning: user {{ user.username }} in realm $realm has id $id, not {{ user.id }}; it was created before"
{%- endif %}
fi
{%- if user.password_json and not user.temporary %}
kc update "users/$id/reset-password" -r "$realm" -f - <<'COMPOST_JSON'
{{ user.password_json }}
COMPOST_JSON
{%- endif %}
{%- if user.attributes_json %}
kc update "users/$id" -r "$realm" --merge -f - <<'COMPOST_JSON'
{{ user.attributes_json }}
COMPOST_JSON
{%- endif %}
{%- if user.roles %}
kc add-roles -r "$realm" --uid "$id"{% for role in user.roles %} --rolename '{{ role }}'{% endfor %} </dev/null
{%- endif %}
{%- endfor %}
{%- endif %}
