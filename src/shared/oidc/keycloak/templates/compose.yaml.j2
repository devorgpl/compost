# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
# compose.override.yaml adds the database and ingress networks and the database settings.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    command: start
    # Read by docker compose (as the deploy user), so the file can stay 0600.
    env_file: [./secrets/keycloak.env]
    environment:
      KC_DB: postgres
      KC_HOSTNAME: "{{ url }}"
      # Apps on the provider network use the internal URL for back-channel requests.
      KC_HOSTNAME_BACKCHANNEL_DYNAMIC: "true"
      # TLS ends at the ingress, which forwards X-Forwarded-* headers.
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_HEALTH_ENABLED: "true"
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      # The image has no curl; ask the management port with bash. Only the
      # status line counts: checks inside a 503 answer can still be UP.
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && read -r status <&3 && [[ $$status == *' 200 '* ]]"]
      interval: 5s
      retries: 30
      start_period: 60s
networks:
  {{ network }}:
    external: true
