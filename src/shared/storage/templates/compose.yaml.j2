# Generated by compost. Do not edit; change compost-server.yaml and run `compost server deploy`.
services:
  {{ service }}:
    image: {{ image }}
    container_name: {{ container }}
    restart: unless-stopped
    # As the server user, so that compost can back up and remove its files.
    user: "{{ user }}"
    volumes:
      - ./garage.toml:/etc/garage.toml:ro
      - ./meta:/var/lib/garage/meta
      - ./data:/var/lib/garage/data
    networks:
      {{ network }}:
        aliases: [{{ host }}]
    healthcheck:
      test: ["CMD", "/garage", "status"]
      interval: 5s
      retries: 12
networks:
  {{ network }}:
    external: true
